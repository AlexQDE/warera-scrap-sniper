# Only the optional dashboard reads this file, and it writes it for you: on the
# first run `node dashboard/scrapdash.mjs` asks for your WarEra API key and
# saves it here. You can also create the file yourself:
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# and paste the key after the equals sign. `.env` is gitignored: never commit
# it. The extension does not use this file; its key goes into its settings page.
WARERA_API_KEY=
